# Your keys and tokens. Copy this file to .env and fill it in. Never share .env or commit it.

# ---- Instagram (Meta) -------------------------------------------------------
# Instagram API with Facebook Login (api = "facebook_login" in config.toml, the default).
# Create an app at https://developers.facebook.com/apps/ to get these three,
# then run `uv run igdm connect`:
META_APP_ID=
META_APP_SECRET=
FB_USER_TOKEN=
# `igdm connect` writes these three for you (the Page token never expires):
IG_PAGE_TOKEN=
FB_PAGE_ID=
IG_ACCOUNT_ID=

# Only for api = "instagram_login" (the older graph.instagram.com setup). Also from
# https://developers.facebook.com/apps/
IG_ACCESS_TOKEN=

# ---- Spotting requests ------------------------------------------------------
# Jev (TypeSafe) key, from https://typesafe.ai. Optional: without it, OpenAI spots requests.
TYPESAFE_API_KEY=

# ---- Email ------------------------------------------------------------------
# Gmail app password for the [email] from_address in config.toml. Create one at
# https://myaccount.google.com/apppasswords (your Google account needs 2-Step Verification on).
GMAIL_APP_PASSWORD=

# ---- AI-written replies ([llm] in config.toml picks the provider) -----------
# OpenAI key, from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Alerts (cloud server only) ---------------------------------------------
# A private ntfy topic name you make up (https://ntfy.sh): the ntfy phone app subscribes to it.
NTFY_TOPIC=
# A healthchecks.io ping URL (https://healthchecks.io): if the bot stops pinging,
# healthchecks.io alerts you itself.
HEALTHCHECKS_URL=
# Where alert emails go (default: the [email] from_address in config.toml)
ALERT_EMAIL=
